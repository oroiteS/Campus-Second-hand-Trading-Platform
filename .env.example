# ============================================================
# Campus 二手交易平台 - 本地基础设施配置模板
#
# 使用方法：cp .env.example .env 然后填入自己的值
# 真实 .env 已被 .gitignore 忽略，请勿提交
# ============================================================

# --- MongoDB ---
# 默认认证：root / 你设置的密码，库名自定（首次写入自动创建）
# 连接串：mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@127.0.0.1:${MONGO_PORT}/campus?authSource=admin
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me
MONGO_PORT=27017

# --- MySQL ---
# 应用请用 MYSQL_USER 连接，不要用 root
# 连接串：mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@127.0.0.1:${MYSQL_PORT}/${MYSQL_DATABASE}
# 注意：MySQL 8 默认认证插件为 caching_sha2_password，
#       Python 连接需额外安装 cryptography 包（uv add cryptography）
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=campus_trading
MYSQL_USER=campus_app
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

# --- Redis ---
# 连接串：redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# --- ChromaDB（仅绑本机，未启用认证）---
# 连接地址：http://127.0.0.1:${CHROMA_PORT}
CHROMA_PORT=8000

# --- Embedding API ---
embedding_api_key=change_me
embedding_base_url=https://change_me/v1 
embedding_model=qwen3.7-text-embedding-flash
embedding_dim=1024

