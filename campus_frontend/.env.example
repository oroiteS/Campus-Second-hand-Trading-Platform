# 前端环境变量（复制为 .env 使用；.env / .env.local 均不入 git）
#
# 注意：VITE_API_BASE 与 VITE_PROXY_TARGET 语义不同，不要混用。
#   - VITE_API_BASE      → axios 的 baseURL（含 /api 后缀），会被打进构建产物
#   - VITE_PROXY_TARGET  → 仅 dev server 的代理目标，不会进入产物

# true 时 api 层切换到 src/api/mock/ 契约同构假数据；false（或留空）走真实接口
VITE_USE_MOCK=true

# axios 基址（含 /api 后缀）。留空 = 同源 '/api'，dev 下由 vite 代理转发到 VITE_PROXY_TARGET；
# 跨域直连或生产部署时填完整基址，必须带 /api，如 http://127.0.0.1:5010/api
# 不要把纯主机地址（如 http://127.0.0.1:5030）填在这里——那样请求会缺少 /api 前缀。
VITE_API_BASE=

# 仅 dev server 的代理目标（可不带 /api），默认 http://127.0.0.1:5010。
# 联调其他后端时改这里即可，无需改动 VITE_API_BASE。
VITE_PROXY_TARGET=
