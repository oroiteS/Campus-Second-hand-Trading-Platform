# ============================================================
# campus_backend 应用配置模板
#
# 使用方法：cp .env.example .env 然后填入真实值（凭据取自仓库根
# 目录 .env，即 docker-compose 用的那份；本文件仅模板，入 git，
# 真实 .env 不入 git）。
#
# worktree 隔离参数（DB_TABLE_PREFIX / MONGO_DB / REDIS_DB_BASE /
# CHROMA_COLLECTION_SUFFIX）由任务卡指定；主仓一律用下方默认值。
# ============================================================

# --- 应用 ---
FLASK_ENV=development        # development | production
PORT=5000                    # 主仓默认；worktree 用 5010/5020，集成 5030
SECRET_KEY=change_me         # 随机串，如 python -c "import secrets; print(secrets.token_hex(32))"
JWT_EXPIRE_MINUTES=1440

# --- MySQL（应用账号，勿用 root）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=campus_trading
MYSQL_USER=campus_app
MYSQL_PASSWORD=change_me

# --- MongoDB ---
# 真实凭据只写本地 .env（.env 不入 git，NFR-13）；本文件只放 change_me 占位。
# 认证库由 authSource 指定：compose 的 mongodb 用 admin 库的 root 账号认证，
# 故本机默认串带 authSource=admin；URI 路径里的库名仅占位，实际库名用 MONGO_DB。
MONGO_URI=mongodb://change_me:change_me@127.0.0.1:27017/campus_market?authSource=admin
MONGO_DB=campus_market       # worktree 改为 campus_market_<任务代号>

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB_BASE=0              # 主仓占 db0-3；开发槽位 4/8，集成 12

# --- Chroma ---
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION_SUFFIX=    # worktree 填任务代号（如 b0be）

# --- Embedding 生效模式 ---
# local（默认）= 只探本地侧车，零云端请求、零 5s 云端等待、零云端费用；
# cloud         = 只探云端（旧行为），失败不回落本地；
# auto          = 旧行为：云端优先、本地兜底（先探云端 5s 超时，失败再探本地）。
# 非法取值（含空串）会回退 local 并落 WARNING。切回云端只需把本行改成 cloud 或 auto。
EMBEDDING_MODE=local

# --- Embedding 云端端点（仅 EMBEDDING_MODE=cloud|auto 时需要）---
# 默认 local 模式不读取、不发请求；保留配置只为将来一行切回云端。
EMBEDDING_BASE_URL=https://change_me.example.com/v1
EMBEDDING_API_KEY=change_me
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024

# --- 本地 Embedding 侧车（tools/local_embedding，独立进程）---
# 默认 local 模式即打这里，/api/health 报 mode=local；启动方式见
# tools/local_embedding/README.md（默认端口 8010）。
EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:8010/v1
EMBEDDING_LOCAL_MODEL=qwen3_embedding_0_6b
# 仅 auto 模式生效：true = 云端不可用时降级到本地侧车；false = 关闭兜底。
# local 模式显式选择了本地，恒探测本项，不受该开关影响。
EMBEDDING_LOCAL_ENABLED=true

# --- 向量与推荐（b2be2）---
# 检索指令前缀：搜索时拼在用户查询前，引导指令感知模型进入检索语义。
# 默认 Qwen3 官方检索指令；切模型按模型卡调整——修改后须全量重建向量。
EMBEDDING_QUERY_PREFIX=Given a web search query, retrieve relevant passages that answer the query
# 向量重试补偿线程开关（60s 重放 queue:vector:retry）：1 开（默认），
# 0 关（多进程部署时只留一个实例开）。
VECTOR_RETRY_WORKER=1

# --- 上传 ---
UPLOAD_DIR=uploads           # 相对 campus_backend/ 或绝对路径
MAX_UPLOAD_MB=5

# --- worktree 表前缀（主仓为空；worktree 如 b0be-）---
DB_TABLE_PREFIX=
