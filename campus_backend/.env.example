# ============================================================
# campus_backend 应用配置模板
#
# 使用方法：cp .env.example .env 然后填入真实值（凭据取自仓库根
# 目录 .env，即 docker-compose 用的那份；本文件仅模板，入 git，
# 真实 .env 不入 git）。
#
# worktree 隔离参数（DB_TABLE_PREFIX / MONGO_DB / REDIS_DB_BASE /
# CHROMA_COLLECTION_SUFFIX）由任务卡指定；主仓一律用下方默认值。
# ============================================================

# --- 应用 ---
FLASK_ENV=development        # development | production
PORT=5000                    # 主仓默认；worktree 用 5010/5020，集成 5030
SECRET_KEY=change_me         # 随机串，如 python -c "import secrets; print(secrets.token_hex(32))"
JWT_EXPIRE_MINUTES=1440

# --- MySQL（应用账号，勿用 root）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=campus_trading
MYSQL_USER=campus_app
MYSQL_PASSWORD=change_me

# --- MongoDB ---
# URI 中路径库名无关紧要（认证走 authSource=admin），实际库名用 MONGO_DB
MONGO_URI=mongodb://root:change_me@127.0.0.1:27017/campus_market?authSource=admin
MONGO_DB=campus_market       # worktree 改为 campus_market_<任务代号>

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB_BASE=0              # 主仓占 db0-3；开发槽位 4/8，集成 12

# --- Chroma ---
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION_SUFFIX=    # worktree 填任务代号（如 b0be）

# --- Embedding（OpenAI 兼容端点：云端优先、本地侧车兜底）---
EMBEDDING_BASE_URL=https://change_me.example.com/v1
EMBEDDING_API_KEY=change_me
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024

# --- 本地 Embedding 侧车（tools/local_embedding，独立 Python 3.10 进程）---
# 云端探活失败且启用时，/api/health 降级为 mode=local；启动方式见
# tools/local_embedding/README.md（默认端口 8010）。
EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:8010/v1
EMBEDDING_LOCAL_MODEL=qwen3_embedding_0_6b
EMBEDDING_LOCAL_ENABLED=true # false=关闭本地兜底（云端不可用即 mode=null/down）

# --- 上传 ---
UPLOAD_DIR=uploads           # 相对 campus_backend/ 或绝对路径
MAX_UPLOAD_MB=5

# --- worktree 表前缀（主仓为空；worktree 如 b0be-）---
DB_TABLE_PREFIX=
